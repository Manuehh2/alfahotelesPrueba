---
import '../../styles/global.css';
import { escapeHTML, toHTML } from '@portabletext/to-html';
import { formatPostDate } from '../../data/posts';
import { getPosts, type BlogPost } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.filter((post) => post.slug).map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: BlogPost };
const base = import.meta.env.BASE_URL;
const body = toHTML(post.body || [], {
  components: {
    types: {
      image: ({ value }) => value.url ? `<figure><img src="${escapeHTML(value.url)}" alt="${escapeHTML(value.alt || '')}" loading="lazy"></figure>` : '',
    },
  },
});
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={post.excerpt} />
    <title>{post.title} | Alfa Hoteles</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="blog-header"><nav class="blog-nav wrap" aria-label="Navegación del blog"><a class="brand" href={base} aria-label="Alfa Hoteles, inicio"><img src={`${base}/images/alfa-hoteles-logo.png`} alt="Alfa Hoteles" /></a><div class="blog-nav-links"><a href={base}>Inicio</a><a href={`${base}/blog/`}>Blog</a><a href={`${base}/#coleccion`}>Hoteles</a></div><a class="button button-dark" href="https://wa.me/529993700408" target="_blank" rel="noreferrer">Reservar <span>↗</span></a></nav></header>
    <main>
      <article class="article-page">
        <header class="article-heading wrap"><a class="text-link" href={`${base}/blog/`}>← Volver al blog</a><div class="post-meta"><span>{post.category}</span><time datetime={post.date}>{formatPostDate(post.date)}</time></div><h1>{post.title}</h1><p>{post.excerpt}</p></header>
        {post.image && <img class="article-cover" src={post.image} alt="" />}
        <div class="article-body wrap" set:html={body} />
      </article>
      <section class="article-end wrap"><a class="text-link" href={`${base}/blog/`}>Explorar más artículos <span aria-hidden="true">↗</span></a></section>
    </main>
    <footer class="footer wrap"><a class="brand footer-brand" href={base} aria-label="Alfa Hoteles, inicio"><img src={`${base}/images/alfa-hoteles-logo.png`} alt="Alfa Hoteles" /></a><p>© {new Date().getFullYear()} Alfa Hoteles</p><a class="text-link" href={`${base}/#contacto`}>Contacto <span aria-hidden="true">↗</span></a></footer>
  </body>
</html>
