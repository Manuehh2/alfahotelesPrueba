---
import '../../styles/global.css';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/blog';

const base = import.meta.env.BASE_URL;
const posts = await getPosts();
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Historias de nuestros hoteles y guías para descubrir Mérida, Yucatán." />
    <title>Blog | Alfa Hoteles</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="blog-header">
      <nav class="blog-nav wrap" aria-label="Navegación del blog">
        <a class="brand" href={base} aria-label="Alfa Hoteles, inicio"><img src={`${base}/images/alfa-hoteles-logo.png`} alt="Alfa Hoteles" /></a>
        <div class="blog-nav-links"><a href={base}>Inicio</a><a href={`${base}/#coleccion`}>Hoteles</a><a href={`${base}/#contacto`}>Contacto</a></div>
        <a class="button button-dark" href="https://wa.me/529993700408" target="_blank" rel="noreferrer">Reservar <span>↗</span></a>
      </nav>
    </header>
    <main>
      <section class="blog-intro wrap">
        <p class="eyebrow">Alfa Hoteles · Mérida, Yucatán</p>
        <h1>Historias para <em>quedarse.</em></h1>
        <p>Conoce las casas de la colección y encuentra ideas para vivir Mérida desde otra perspectiva.</p>
      </section>
      <section class="blog-list wrap" aria-label="Artículos del blog">
        <div class="post-grid">{posts.map((post) => <PostCard post={post} />)}</div>
      </section>
    </main>
    <footer class="footer wrap"><a class="brand footer-brand" href={base} aria-label="Alfa Hoteles, inicio"><img src={`${base}/images/alfa-hoteles-logo.png`} alt="Alfa Hoteles" /></a><p>© {new Date().getFullYear()} Alfa Hoteles</p><a class="text-link" href={base}>Volver al inicio <span aria-hidden="true">↗</span></a></footer>
  </body>
</html>
